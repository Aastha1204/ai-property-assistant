# ───────── Required for the owner dashboard ─────────
ADMIN_PASSWORD=choose-a-long-password

# ───────── AI model (optional; without it the built-in rule-based assistant answers) ─────────
# anthropic | openai | openai-compatible
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ───────── Database (required on Vercel so leads/listings persist) ─────────
# Add "Upstash Redis" from the Vercel Marketplace; it injects KV_REST_API_URL / KV_REST_API_TOKEN,
# or paste these two from console.upstash.com:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────── WhatsApp Business Cloud API (Meta) ─────────
WA_ACCESS_TOKEN=          # permanent system-user token
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=          # any random string; paste the same in Meta's webhook setup
WA_APP_SECRET=            # Meta app secret, used to verify webhook signatures
OWNER_WA_NUMBER=          # e.g. 919820011223, gets a message when a lead turns HOT
WA_OWNER_TEMPLATE=        # optional approved template (1 body variable) for owner alerts
WA_FOLLOWUP_TEMPLATE=     # approved template (2 vars: name, interest) for the 24h follow-up
WA_TEMPLATE_LANG=en
CRON_SECRET=              # any random string; Vercel Cron sends it automatically
